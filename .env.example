# Aimarage - Einstellungen für die Selbst-Installation (docker compose)
# Kopieren: cp .env.example .env, dann die Pflichtfelder ausfüllen.

# --- Pflicht ---

# Datenbank-Passwort, nur Buchstaben und Ziffern (z.B. openssl rand -hex 24)
POSTGRES_PASSWORD=

# Erstes Konto, wird beim ersten Start angelegt (Anmeldename, z.B. deine Mailadresse)
SEED_EMAIL=
# Leer = zufälliges Passwort, steht dann einmal im Log (docker compose logs app)
SEED_PASSWORD=

# --- Adresse ---

# Port auf diesem Rechner (nur localhost)
AIMARAGE_PORT=3210
# Adresse, unter der du Aimarage im Browser öffnest (für Links, Kalender-Abo, Passkeys, OAuth)
APP_URL=http://localhost:3210
# Mit https (Reverse Proxy davor) auf true setzen, sonst false lassen
SECURE_COOKIES=false
# Hinter einem Reverse Proxy (Caddy, nginx) auf true setzen
TRUST_PROXY=false

# --- Erststart ---

SEED_ON_START=owner
SEED_NAME=
SEED_WORKSPACE=
# de oder en
SEED_LOCALE=de
SEED_TIMEZONE=Europe/Vienna

# Hauptschlüssel für gespeicherte Zugänge (KI-, Social-, Postfach-Schlüssel).
# Leer = wird beim ersten Start erzeugt und im Volume appdata gespeichert (data/app-secret).
APP_SECRET=

# --- KI (Pflicht für den Agenten, alternativ in der App unter Einstellungen > KI) ---

# Anthropic: LLM_BASE_URL=https://api.anthropic.com, LLM_MODEL=claude-sonnet-5-5, LLM_MODEL_FAST=claude-haiku-5-5
# Andere OpenAI-kompatible Anbieter: deren /v1-Adresse und Modellname
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_FAST=
# Modell für Blog-Artikel. Leer = bestes Modell des Anbieters (Anthropic: claude-opus-5-5), gleich LLM_MODEL = aus
LLM_MODEL_WRITER=

# --- Mail (optional) ---

# Für Anmeldecodes, Morgen-Mail und Hinweise, z.B. smtp://benutzer:passwort@smtp-relay.brevo.com:587
SMTP_URL=
# Absender, z.B. Aimarage <aimarage@deine-domain.at>
MAIL_FROM=
MAIL_REPLY_TO=

# --- Social-Posting (optional, alternativ je Arbeitsbereich in der App) ---

ZERNIO_API_KEY=
UPLOAD_POST_API_KEY=

# --- Medien-Speicher (optional, Standard: lokal im Volume appdata) ---

STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
